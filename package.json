{
  "name": "ede-gestao",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "stack:up": "bash scripts/local-stack/up.sh",
    "stack:down": "bash scripts/local-stack/down.sh",
    "stack:status": "bash scripts/local-stack/status.sh",
    "stack:smoke": "node scripts/local-stack/smoke.mjs",
    "db:reset": "bash scripts/db/reset.sh",
    "db:test": "bash scripts/db/test.sh",
    "db:rollback-check": "bash scripts/db/check-rollbacks.sh",
    "db:types": "node scripts/db/gen-types.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:secrets && pnpm db:test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
