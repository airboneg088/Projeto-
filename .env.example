# Variáveis de ambiente do Éde Gestão. Nunca coloque valores reais neste arquivo.
# Desenvolvimento: `pnpm stack:up` gera o .env.local com os valores da stack local.
# Produção: configure os valores nas variáveis de ambiente da Vercel.

# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (anon). Pode ir ao navegador; a RLS protege os dados.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (service_role). SOMENTE no servidor. Nunca importar em código de cliente.
SUPABASE_SECRET_KEY=
# URL pública do app (links de e-mail e redirecionamentos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Conexão direta com o Postgres (scripts e testes; não usada pelo app no navegador)
DATABASE_URL=
# Catálogo de componentes e protótipos (/prototipo/*). Só "1" liga; deixe vazio em produção.
ENABLE_PROTOTYPES=
